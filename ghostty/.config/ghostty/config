# Zen&Cursor inspired theme - Dark Subtle (Current)
# --------------------------

# ── Atmosphere ──────────────────────────
background = #151719
foreground = #D4D6D8
background-opacity = 0.83
# Blur uses a macOS material that turns opaque when the window loses focus.
#background-blur = true
background-blur = true
# Painted cells stay solid so the prompt arrows keep a hard edge.
#background-opacity-cells = true
background-opacity-cells = false
# An unfocused split is otherwise dimmed, which reads as a solid overlay.
unfocused-split-opacity = 1

# ── Cursor ──────────────────────────────
cursor-color = #B4BCC2
cursor-text = #151719
cursor-style = block
cursor-style-blink = false
# Shell integration otherwise forces a bar at the prompt.
shell-integration-features = no-cursor

# ── Selection ───────────────────────────
selection-background = #505860
selection-foreground = #E4E6E7

